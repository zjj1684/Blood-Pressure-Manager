<?xml version="1.0" encoding="utf-8"?>
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <!-- 左侧色条 -->
    <item android:right="@dimen/radius_md">
        <shape android:shape="rectangle">
            <solid android:color="@color/primary" />
            <corners
                android:topLeftRadius="@dimen/radius_sm"
                android:bottomLeftRadius="@dimen/radius_sm" />
        </shape>
    </item>
    <!-- 卡片主体 -->
    <item android:left="4dp">
        <shape android:shape="rectangle">
            <solid android:color="@color/surface" />
            <corners
                android:topRightRadius="@dimen/radius_sm"
                android:bottomRightRadius="@dimen/radius_sm" />
        </shape>
    </item>
</layer-list>
